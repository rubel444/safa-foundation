# Supabase দিয়ে পাবেন (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin login (নিজে যা খুশি বসান)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# একটা লম্বা, র‍্যান্ডম, গোপন কোড - সেশন সাইন করতে ব্যবহার হয়
ADMIN_SECRET=make-this-a-long-random-string-1234567890
